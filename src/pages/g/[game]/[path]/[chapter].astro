---
import { getCollection } from "astro:content";
import AppShell from "../../../../layouts/AppShell.astro";
import StepChecklist from "../../../../components/StepChecklist";
import { PATHS, stepMatchesPath, type PathId } from "../../../../config/paths";

export async function getStaticPaths() {
  const chapters = await getCollection("chapters");
  const pathIds = Object.keys(PATHS) as PathId[];
  return chapters.flatMap(ch =>
    pathIds.map(p => ({ params: { game: ch.data.game, path: p, chapter: ch.data.id }, props: { ch: ch.data, pathId: p } }))
  );
}
const { ch, pathId } = Astro.props;
const allGameChapters = (await getCollection("chapters"))
  .filter(c => c.data.game === ch.game)
  .sort((a, b) => a.data.order - b.data.order);
const idx = allGameChapters.findIndex(c => c.data.id === ch.id);
const prevUrl = idx > 0 ? `/g/${ch.game}/${pathId}/${allGameChapters[idx - 1].data.id}` : undefined;
const nextUrl = idx < allGameChapters.length - 1 ? `/g/${ch.game}/${pathId}/${allGameChapters[idx + 1].data.id}` : undefined;
const glossary = (await getCollection("glossary")).find(g => g.data.game === ch.game)?.data.terms || {};
const filteredSteps = ch.steps.filter(s => stepMatchesPath(s.tags, pathId));
---
<AppShell title={`${ch.title} (${PATHS[pathId].name})`} gameId={ch.game} activePath={pathId} chapterId={ch.id}>
  <div class="ch-head">
    <div class="ch-num-bg">{ch.num}</div>
    <h1 class="ch-title">{ch.title}</h1>
    <p style="font-size:14px;color:var(--muted);margin:4px 0 0;">{ch.summary}</p>
  </div>
  <StepChecklist client:load gameId={ch.game} pathId={pathId} chapterId={ch.id} prevUrl={prevUrl} nextUrl={nextUrl} glossary={glossary} steps={filteredSteps} />
</AppShell>

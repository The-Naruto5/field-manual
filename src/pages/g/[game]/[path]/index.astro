---
import { getCollection } from "astro:content";
import AppShell from "../../../../layouts/AppShell.astro";
import ResumeButton from "../../../../components/ResumeButton";
import { PATHS, stepMatchesPath, type PathId } from "../../../../config/paths";

export async function getStaticPaths() {
  const games = await getCollection("games");
  const pathIds = Object.keys(PATHS) as PathId[];
  return games.flatMap(g =>
    pathIds.map(p => ({ params: { game: g.data.id, path: p }, props: { game: g.data, pathId: p } }))
  );
}

const { game, pathId } = Astro.props;
const rule = PATHS[pathId];
const chapters = (await getCollection("chapters"))
  .filter(c => c.data.game === game.id)
  .sort((a, b) => a.data.order - b.data.order);
const stepList = chapters.flatMap(ch => ch.data.steps.filter(s => stepMatchesPath(s.tags, pathId)).map(s => ({ chId: ch.data.id, stepId: s.id })));
---
<AppShell title={`${game.title} — ${rule.name} Overview`} gameId={game.id} accent={game.accent} activePath={pathId}>
  <div class="ch-head" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:12px;">
    <div class="ch-num-bg">PTH</div>
    <div>
      <h1 class="ch-title">{rule.name} Path — {game.title}</h1>
      <p style="font-size:13.5px;color:var(--muted);margin:4px 0 0;">{rule.suits} ({rule.time})</p>
    </div>
    <ResumeButton client:load gameId={game.id} stepList={stepList} />
  </div>

  <div style="display:grid;gap:10px;">
    {chapters.map(ch => {
      const fSteps = ch.data.steps.filter(s => stepMatchesPath(s.tags, pathId));
      const missCount = fSteps.filter(s => s.tags.includes("missable")).length;
      const bossCount = fSteps.filter(s => s.tags.includes("boss")).length;
      return (
        <a href={`/g/${game.id}/${pathId}/${ch.data.id}`} class="panel" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;text-decoration:none;color:inherit;">
          <div>
            <div class="fm" style="font-size:11px;color:var(--accent);">CHAPTER {ch.data.num}</div>
            <strong style="font-size:16px;">{ch.data.title}</strong>
            <div style="font-size:12.5px;color:var(--muted);margin-top:2px;">{ch.data.summary}</div>
          </div>
          <div class="fm" style="font-size:12px;color:var(--muted);white-space:nowrap;">
            {fSteps.length} steps • {bossCount} bosses • {missCount} missables &rarr;
          </div>
        </a>
      );
    })}
  </div>
</AppShell>

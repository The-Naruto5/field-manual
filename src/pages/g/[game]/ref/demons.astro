---
import { getCollection } from "astro:content";
import AppShell from "../../../../layouts/AppShell.astro";
import DemonLookup from "../../../../components/DemonLookup";

export async function getStaticPaths() {
  const all = await getCollection("demons");
  return all.map(d => ({ params: { game: d.data.game }, props: { data: d.data } }));
}
const { data } = Astro.props;
---
<AppShell title="Battle, Contact & Demon Q&A" gameId={data.game}>
  <div class="ch-head">
    <div class="ch-num-bg">CON</div>
    <h1 class="ch-title">Battle, Contact &amp; Demon Q&amp;A</h1>
    <p style="font-size:13px;color:var(--muted);margin:4px 0 0;">Instant weaknesses, Eager/Happy contacts, 3-Pact tracker, and searchable Demon Q&amp;A + Personality guide.</p>
  </div>
  <DemonLookup client:load demons={data.items} qa={data.qa || []} personalities={data.personalities || []} />
</AppShell>

---
import { getCollection } from "astro:content";
import AppShell from "../../../../layouts/AppShell.astro";

export async function getStaticPaths() {
  const games = await getCollection("games");
  return games.map(g => ({ params: { game: g.data.id }, props: { game: g.data } }));
}
const { game } = Astro.props;

const p2isCheats = [
  { title: "Infinite Money (PSP USA)", code: "_C0 Infinite Money\n_L 0x2063AC2C 0x3B9AC9FF" },
  { title: "All Tarot Cards x999 (PSP USA)", code: "_C0 All Cards x999\n_L 0x8063AFBA 0x00800001\n_L 0x100003E7 0x00000000" },
  { title: "1/4 Encounter Rate (PSP USA)", code: "_C0 1/4 Encounters\n_L 0x20001600 0x000420C2\n_L 0x20001604 0x0A258A84\n_L 0x20001608 0x00821821\n_L 0x20162A08 0x0A200580\n_L 0x20162A0C 0x8E02110C" },
  { title: "EXP x4 (PSP USA)", code: "_C0 experience x004\n_L 0xC01592A4 0x0E200400\n_L 0xC01592A8 0x00061080\n_L 0x20001000 0x24420004\n_L 0x20001004 0x03E00008\n_L 0x20001008 0x00031880" },
  { title: "EXP x16 (PSP USA)", code: "_C0 experience x016\n_L 0xC01592A4 0x0E200400\n_L 0xC01592A8 0x00061080\n_L 0x20001000 0x24420004\n_L 0x20001004 0x03E00008\n_L 0x20001008 0x00031900" }
];
---
<AppShell title="CWCheats & Emulator QoL" gameId={game.id} accent={game.accent}>
  <div class="ch-head">
    <div class="ch-num-bg">QOL</div>
    <h1 class="ch-title">CWCheats &amp; Emulator QoL</h1>
    <p style="font-size:13px;color:var(--muted);margin:4px 0 0;">Optional speed-up tips and PSP USA CWCheat codes for PPSSPP / real hardware.</p>
  </div>

  <div class="panel" style="margin-bottom:16px;border-left:3px solid var(--tip);">
    <strong class="fh" style="font-size:15px;">Built-In Speed &amp; QoL Tips</strong>
    <ul style="margin:6px 0 0;padding-left:18px;font-size:13px;color:var(--muted);">
      <li>Enable <strong>Skip Battle Animations</strong> in the PSP System Menu to make random encounters and Fusion Spells 3x faster.</li>
      <li>Press <strong>Square</strong> anytime inside a dungeon to inspect the full floor map.</li>
      <li>Use <strong>Estoma</strong> (Nemesis Lv. 24 / Umayadono-Ouji Lv. 23 in IS) to skip lower-level random encounters cleanly.</li>
    </ul>
  </div>

  {game.id === "persona2-is" ? (
    <div style="display:grid;gap:10px;">
      {p2isCheats.map(c => (
        <div class="panel">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
            <strong class="fh" style="font-size:15px;">{c.title}</strong>
            <button type="button" class="btn copy-cheat" data-code={c.code}>Copy Code</button>
          </div>
          <pre class="fm" style="margin:0;padding:8px;background:var(--bg);border:1px solid var(--line);border-radius:var(--r);font-size:11.5px;overflow-x:auto;">{c.code}</pre>
        </div>
      ))}
    </div>
  ) : (
    <div class="panel" style="font-size:13px;color:var(--muted);">
      For <strong>Persona 2: Eternal Punishment</strong>, enable <strong>Speedy</strong> battle speed and cutscene fast-forward in the PSP English fan-translated version (July 2022), or bind emulator turbo on PS1 for Bomb Shelter grinding.
    </div>
  )}

  <script is:inline>
    document.querySelectorAll(".copy-cheat").forEach(btn => {
      btn.addEventListener("click", () => {
        const code = btn.dataset.code || "";
        navigator.clipboard?.writeText(code).then(() => window.showFmToast?.("Copied CWCheat to clipboard")).catch(() => {});
      });
    });
  </script>
</AppShell>

---
import { getCollection } from "astro:content";
import AppShell from "../../../../layouts/AppShell.astro";
import QuestTracker from "../../../../components/QuestTracker";

export async function getStaticPaths() {
  const all = await getCollection("quests");
  return all.map(q => ({ params: { game: q.data.game }, props: { data: q.data } }));
}
const { data } = Astro.props;
---
<AppShell title="Side Quests, Weapons, Rumormongers & Material Cards" gameId={data.game}>
  <div class="ch-head"><div class="ch-num-bg">QST</div><h1 class="ch-title">Side Quests, Weapons &amp; Rumormongers</h1></div>
  <QuestTracker
    client:load
    gameId={data.game}
    sideQuests={data.sideQuests}
    ultimateWeapons={data.ultimateWeapons}
    rumormongers={data.rumormongers || []}
    materialCards={data.materialCards || []}
  />
</AppShell>
